# Copy this file to .env and fill in values from your Supabase project
# (Supabase dashboard -> Project Settings -> API).
# The anon key is safe to expose in the browser; it is protected by Row Level Security.
# Leaving these blank runs the app in local preview mode (reads src/data/family.json).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
